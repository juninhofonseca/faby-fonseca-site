---
import '../styles/global.css';
import { withBase } from '../lib/urls';
import {
  CONTACT_EMAIL,
  INSTAGRAM_URL,
  buildMailtoHref,
  buildWhatsappHref,
} from '../lib/contact';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Portfólio fotográfico de Faby Fonseca: casamentos, ensaios, família, newborn e eventos.',
  noindex = false,
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="app-base" content={import.meta.env.BASE_URL} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <title>{title}</title>
    <noscript>
      <style>
        /* Aprimoramento progressivo: sem JavaScript o filtro não roda, então
           todas as categorias ficam visíveis em vez de escondidas. */
        [hidden],
        body .gallery-section[hidden] {
          display: block !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-brand" href={withBase('/')}>Faby Fonseca Fotografia</a>
        <nav class="site-nav" aria-label="Navegação principal">
          <ul role="list">
            <li><a href={withBase('/')}>Início</a></li>
            <li><a href={withBase('/portfolio/')}>Portfólio</a></li>
            <li><a href={withBase('/contato/')}>Contato</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="conteudo" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Faby Fonseca Fotografia. Todos os direitos reservados.</p>
        <ul class="site-footer__links">
          <li>
            <a href={buildMailtoHref()}>{CONTACT_EMAIL}</a>
          </li>
          <li>
            <a href={buildWhatsappHref()} target="_blank" rel="noopener noreferrer">
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href={INSTAGRAM_URL}
              target="_blank"
              rel="noopener noreferrer"
              data-footer-instagram
            >
              Instagram
            </a>
          </li>
          <li>
            <a href={withBase('/privacidade/')}>Política de Privacidade</a>
          </li>
        </ul>
      </div>
    </footer>
  </body>
</html>
