---
import { Image, getImage } from 'astro:assets';
import type { Photo } from '../lib/gallery';

interface Props {
  photo: Photo;
  index: number;
}

const { photo, index } = Astro.props;

const large = await getImage({
  src: photo.image,
  width: 1600,
  format: 'webp',
  quality: 80,
});
---

<a
  href={large.src}
  class="photo-card"
  data-photo-card
  data-index={index}
  data-full-src={large.src}
  data-alt={photo.alt}
  data-title={photo.title}
>
  <Image
    src={photo.image}
    alt={photo.alt}
    widths={[480, 960, 1440]}
    sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 33vw"
    loading="lazy"
    class="photo-card__image"
  />
  <span class="photo-card__caption">{photo.title}</span>
</a>
