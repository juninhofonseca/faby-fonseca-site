---
import type { Category } from '../lib/categories';
import { withBase } from '../lib/urls';

interface Props {
  categories: Category[];
  activeSlug?: string;
}

const { categories, activeSlug } = Astro.props;
const todosActive = !activeSlug;
---

<nav class="category-nav" aria-label="Filtrar por categoria">
  <ul role="list">
    <li>
      <a
        href={withBase('/portfolio/')}
        class:list={['category-link', { 'is-active': todosActive }]}
        aria-current={todosActive ? 'page' : undefined}
        data-category-link="todos"
      >
        Todos
      </a>
    </li>
    {
      categories.map((category) => {
        const isActive = category.data.slug === activeSlug;
        return (
          <li>
            <a
              href={withBase(`/portfolio/?categoria=${category.data.slug}`)}
              class:list={['category-link', { 'is-active': isActive }]}
              aria-current={isActive ? 'page' : undefined}
              data-category-link={category.data.slug}
            >
              {category.data.name}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
