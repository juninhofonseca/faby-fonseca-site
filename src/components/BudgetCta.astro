---
import type { Category } from '../lib/categories';
import { withBase } from '../lib/urls';

interface Props {
  category?: Category;
}

const { category } = Astro.props;
---

{
  category && (
    <p class="budget-cta">
      <a
        class="button"
        href={withBase(`/contato/?categoria=${category.data.slug}`)}
        data-budget-cta
      >
        Quero um orçamento desta categoria
      </a>
    </p>
  )
}
