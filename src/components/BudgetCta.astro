---
import type { Category } from '../lib/categories';
import { withBase } from '../lib/urls';

interface Props {
  category?: Category;
}

const { category } = Astro.props;
const href = category
  ? withBase(`/contato/?categoria=${category.data.slug}`)
  : withBase('/contato/');
---

<p class="budget-cta">
  <a class="button" href={href} data-budget-cta>
    {category ? 'Quero um orçamento desta categoria' : 'Solicitar orçamento'}
  </a>
</p>
