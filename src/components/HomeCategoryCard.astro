---
import { Image } from 'astro:assets';
import type { Category } from '../lib/categories';
import type { Photo } from '../lib/gallery';
import { withBase } from '../lib/urls';

interface Props {
  category: Category;
  photo?: Photo;
}

const { category, photo } = Astro.props;
const { name, slug, description } = category.data;
---

<li class="home-category-card">
  <a
    class="home-category-card__link"
    href={withBase(`/portfolio/?categoria=${slug}`)}
    data-home-category={slug}
  >
    {
      photo ? (
        <Image
          src={photo.image}
          alt={photo.alt}
          widths={[400, 800]}
          sizes="(max-width: 767px) 100vw, 33vw"
          loading="lazy"
          class="home-category-card__image"
        />
      ) : (
        <span class="home-category-card__placeholder" aria-hidden="true">
          {name}
        </span>
      )
    }
    <span class="home-category-card__body">
      <h3>{name}</h3>
      <span class="home-category-card__description">{description}</span>
      <span class="home-category-card__cta">Ver trabalhos</span>
    </span>
  </a>
</li>
