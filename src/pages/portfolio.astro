---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryNav from '../components/CategoryNav.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import BudgetCta from '../components/BudgetCta.astro';
import Lightbox from '../components/Lightbox.astro';
import { getActiveCategories, resolveCategorySlug } from '../lib/categories';
import { getPhotosByCategory } from '../lib/gallery';

const categories = await getActiveCategories();
const requested = Astro.url.searchParams.get('categoria');
const active = resolveCategorySlug(categories, requested);
const photosByCategory = getPhotosByCategory(categories);
---

<BaseLayout
  title="Portfólio | Faby Fonseca Fotografia"
  description="Galeria de casamentos, ensaios, família, newborn e eventos por Faby Fonseca."
>
  <h1>Portfólio</h1>
  <p class="page-intro">
    Percorra as histórias por categoria. Se quiser, filtre pelo tipo de trabalho e solicite um
    orçamento específico.
  </p>

  <CategoryNav categories={categories} activeSlug={active?.data.slug} />
  <GalleryGrid
    categories={categories}
    activeSlug={active?.data.slug}
    photosByCategory={photosByCategory}
  />
  <BudgetCta category={active} />

  <Lightbox label="Fotos do portfólio" />

  <script>
    import '../scripts/gallery.client';
    import '../scripts/lightbox.client';
  </script>
</BaseLayout>
