---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getActiveCategories } from '../lib/categories';
import { withBase } from '../lib/urls';
import {
  CONTACT_EMAIL,
  buildMailtoHref,
  buildWhatsappHref,
  getWeb3FormsKey,
  isFormConfigured,
} from '../lib/contact';

const categories = await getActiveCategories();

const accessKey = getWeb3FormsKey();
const formConfigured = isFormConfigured(accessKey);

// Envio sem JavaScript: o Web3Forms redireciona para uma página estática de confirmação.
const siteOrigin = Astro.site ?? new URL('https://fabyfonseca.com.br');
const redirectUrl = new URL(withBase('/contato/enviado/'), siteOrigin).href;

const emailHref = buildMailtoHref();
const whatsappHref = buildWhatsappHref();
---

<BaseLayout
  title="Contato | Faby Fonseca Fotografia"
  description="Solicite um orçamento para casamentos, ensaios, família, newborn ou eventos."
>
  <h1>Contato</h1>
  <p class="page-intro">
    Conte o que você procura e receba um orçamento personalizado. A categoria escolhida no
    portfólio já vem selecionada aqui e pode ser alterada.
  </p>

  {
    formConfigured ? (
      <ContactForm
        categories={categories}
        accessKey={accessKey}
        redirectUrl={redirectUrl}
        source="direto"
      />
    ) : (
      <section class="contact-direct" data-direct-contact aria-labelledby="contato-direto">
        <h2 id="contato-direto">Fale direto com a Faby</h2>
        <p>
          Para pedir um orçamento, envie um e-mail ou fale pelo WhatsApp. A resposta chega em até
          2 dias úteis.
        </p>
        <ul>
          <li>
            <a href={emailHref} data-contact-email>{CONTACT_EMAIL}</a>
          </li>
          <li>
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" data-contact-whatsapp>
              WhatsApp
            </a>
          </li>
        </ul>
      </section>
    )
  }

  <script>
    import '../scripts/contact.client';
  </script>
</BaseLayout>
